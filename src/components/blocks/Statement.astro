---
const block = Astro.props as Record<string, any>;
---

<section class="border-b py-16 md:py-24">
  <div class="container-ltse mx-auto max-w-3xl text-center">
    <p class="eyebrow" data-editable="text" data-prop="eyebrow">{block.eyebrow}</p>
    <h2 class="mt-6 text-4xl md:text-[45px] md:leading-[1.05]" data-editable="text" data-prop="heading">{block.heading}</h2>
    {
      block.quote && (
        <blockquote class="mx-auto mt-8 max-w-xl text-[13px] leading-relaxed">
          <p data-editable="text" data-prop="quote">“{block.quote}”</p>
          <footer class="mt-1 font-semibold italic" data-editable="text" data-prop="source">{block.source}</footer>
        </blockquote>
      )
    }
  </div>
</section>
