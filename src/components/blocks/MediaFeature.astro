---
import { Card, CardContent } from '@/components/ui/card';
import VideoEmbed from '@/components/VideoEmbed.astro';

const block = Astro.props as Record<string, any>;
---

<section class="border-y bg-secondary py-14">
  <div class="container-ltse grid gap-8 lg:grid-cols-[1.4fr_1fr]">
    <Card className="gap-0 overflow-hidden rounded-none border-foreground/20 py-0 shadow-none">
      <VideoEmbed url={block.video?.url} title={block.video?.title} />
      <CardContent className="p-6">
        <p class="font-serif text-2xl leading-snug md:text-3xl" data-editable="text" data-prop="quote">{block.quote}</p>
        <p class="eyebrow mt-6 text-muted-foreground" data-editable="text" data-prop="attribution">
          {block.attribution}
        </p>
      </CardContent>
    </Card>

    <ul class="divide-y divide-foreground/15" data-editable="array" data-prop="items">
      {
        block.items?.map((item: any) => (
          <li class="flex gap-5 py-5 first:pt-0" data-editable="array-item">
            <img src={item.image} alt="" class="size-24 shrink-0 border object-cover" loading="lazy" />
            <div>
              <p class="font-serif text-lg leading-snug" data-editable="text" data-prop="title">{item.title}</p>
              <a href={item.url} class="eyebrow mt-3 inline-block hover:underline">{item.link_label}</a>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>
