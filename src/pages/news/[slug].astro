---
import { render } from 'astro:content';
import { ArrowLeft, ArrowUpRight } from 'lucide-react';
import BaseLayout from '@/layouts/BaseLayout.astro';
import NewsCard from '@/components/news/NewsCard.astro';
import LinkButton from '@/components/LinkButton';
import { Badge } from '@/components/ui/badge';
import { Separator } from '@/components/ui/separator';
import { categories, categoryLabel, formatDate, getNews } from '@/lib/news';

export async function getStaticPaths() {
  const all = await getNews();
  return all.map((entry) => ({ params: { slug: entry.id }, props: { entry, all } }));
}

const { entry, all } = Astro.props;
const { title, date, category, source, author, image, excerpt, external_url, seo } = entry.data;
const { Content } = await render(entry);
const more = all.filter((e) => e.id !== entry.id).slice(0, 3);
const categorySlug = categories.find((c) => c.id === category)?.slug;
---

<BaseLayout
  title={`${title} | LTSE`}
  seo={{
    description: seo?.description ?? excerpt ?? undefined,
    image: seo?.image ?? image ?? undefined,
    no_index: seo?.no_index ?? false,
  }}
>
  <article>
    <header class="border-b">
      <div class="container-ltse max-w-[860px] py-12 md:py-16">
        <nav class="flex items-center gap-2 text-[13px]" aria-label="Breadcrumb">
          <a href="/insights/" class="inline-flex items-center gap-1 hover:underline">
            <ArrowLeft className="size-3.5" /> News & Insights
          </a>
          <span class="text-muted-foreground">/</span>
          <a href={`/insights/${categorySlug}/`} class="hover:underline">{categoryLabel(category)}</a>
        </nav>

        <div class="mt-8 flex flex-wrap items-center gap-3">
          <Badge variant="secondary" className="eyebrow rounded-none">{source || categoryLabel(category)}</Badge>
          <time class="text-[13px] text-muted-foreground" datetime={date.toISOString()}>{formatDate(date)}</time>
        </div>
        <h1 class="mt-6 text-4xl leading-[1.05] md:text-[56px]" data-editable="text" data-prop="title">{title}</h1>
        {author && <p class="eyebrow mt-6 text-muted-foreground">By {author}</p>}
      </div>
    </header>

    <div class="container-ltse max-w-[860px] py-12 md:py-16">
      {
        image && (
          <img
            src={image}
            alt=""
            class="mb-12 w-full border border-foreground/15"
            data-editable="image"
            data-prop-src="image"
          />
        )
      }
      <div class="prose-ltse text-[16px] leading-relaxed" data-editable="text" data-prop="@content" data-type="block">
        <Content />
      </div>

      {
        external_url && (
          <LinkButton
            className="mt-12"
            href={external_url}
            label={category === 'press-release' ? 'View the source document' : `Read the full story${source ? ` on ${source}` : ''}`}
            linkProps={{ target: '_blank', rel: 'noopener' }}
          />
        )
      }
    </div>
  </article>

  {
    more.length > 0 && (
      <section class="border-t bg-secondary py-14 md:py-20">
        <div class="container-ltse">
          <div class="flex flex-wrap items-end justify-between gap-4">
            <h2 class="text-4xl">More news & insights</h2>
            <a href="/insights/" class="eyebrow inline-flex items-center gap-1 hover:underline">
              View all <ArrowUpRight className="size-3.5" />
            </a>
          </div>
          <Separator className="my-8 bg-foreground/20" />
          <ul class="grid gap-6 md:grid-cols-3">
            {more.map((e) => (
              <li>
                <NewsCard entry={e} />
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }
</BaseLayout>
