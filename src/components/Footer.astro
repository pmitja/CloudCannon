---
import site from '@/data/site.json';
import Logo from '@/components/Logo';
import { Separator } from '@/components/ui/separator';

const { footer, logo } = site;

const icons: Record<string, string> = {
  linkedin:
    'M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z',
  youtube:
    'M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.6 12 3.6 12 3.6s-7.5 0-9.4.5A3 3 0 0 0 .5 6.2 31 31 0 0 0 0 12a31 31 0 0 0 .5 5.8 3 3 0 0 0 2.1 2.1c1.9.5 9.4.5 9.4.5s7.5 0 9.4-.5a3 3 0 0 0 2.1-2.1A31 31 0 0 0 24 12a31 31 0 0 0-.5-5.8zM9.6 15.6V8.4l6.2 3.6-6.2 3.6z',
  x: 'M18.24 2.25h3.31l-7.23 8.26 8.5 11.24h-6.66l-5.21-6.82-5.97 6.82H1.67l7.73-8.84L1.25 2.25h6.83l4.71 6.23 5.45-6.23zm-1.16 17.52h1.83L7.08 4.13H5.12l11.96 15.64z',
  bluesky:
    'M5.2 2.9C8 5 10.9 9.1 12 11.3c1.1-2.2 4-6.3 6.8-8.4 2-1.5 5.2-2.6 5.2 1 0 .7-.4 6-.7 6.8-.9 3-4 3.8-6.7 3.3 4.8.8 6 3.5 3.4 6.2-5 5.1-7.2-1.3-7.7-2.9l-.3-.8-.3.8c-.5 1.6-2.7 8-7.7 2.9-2.6-2.7-1.4-5.4 3.4-6.2-2.7.5-5.8-.3-6.7-3.3C.4 9.9 0 4.6 0 3.9c0-3.6 3.2-2.5 5.2-1z',
};
---

<footer class="bg-brand-ink text-white">
  <div class="container-ltse grid gap-12 py-16 lg:grid-cols-[220px_1fr]">
    <a href="/" aria-label="LTSE home" class="self-start">
      <Logo {...logo} inverted />
    </a>
    <div class="grid grid-cols-2 gap-x-8 gap-y-10 md:grid-cols-4">
      {
        footer.columns.map((column) => (
          <div>
            <p class="eyebrow mb-4 text-white/70">{column.title}</p>
            <ul class="grid gap-3 text-[13px]">
              {column.links.map((link) => (
                <li>
                  <a href={link.url} class="hover:underline underline-offset-4">
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
  <div class="container-ltse pb-12">
    <Separator className="bg-white/25" />
    <div class="flex flex-col gap-6 pt-8 text-[12px] md:flex-row md:items-center md:justify-between">
      <p class="uppercase tracking-wider">{footer.copyright}</p>
      <ul class="flex flex-wrap gap-x-8 gap-y-2">
        {footer.legal_links.map((link) => <li><a href={link.url} class="hover:underline">{link.label}</a></li>)}
      </ul>
      <ul class="flex gap-4">
        {
          footer.social.map((item) => (
            <li>
              <a href={item.url} aria-label={item.platform} class="block opacity-90 hover:opacity-100">
                <svg viewBox="0 0 24 24" class="size-5 fill-current" aria-hidden="true">
                  <path d={icons[item.platform]} />
                </svg>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</footer>
